{
  "name": "@pet/shared",
  "version": "2.0.0-dev.0",
  "type": "module",
  "description": "纯类型、事件总线、错误码、HLC：零副作用，不依赖 Electron / PIXI / DOM",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
